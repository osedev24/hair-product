NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require
NEON_BRANCH=production
NEON_AUTH_BASE_URL=https://your-neon-auth-host/dbname/auth
NEON_AUTH_JWKS_URL=https://your-neon-auth-host/dbname/auth/.well-known/jwks.json
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-this-before-deploy
VITE_STORE_NAME=Botanical Hair Care
VITE_UPLOAD_PROVIDER=local
DELIVERY_FEE=1500
WHATSAPP_PHONE=2348000000000
CLIENT_ORIGIN=http://localhost:5173
